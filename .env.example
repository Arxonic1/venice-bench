VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Benchmark baseline — all other models get auto-compared to this one.
BENCHMARK_MODEL=claude-opus-4-7

# Optional — enables drift tracking across runs
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional — if set, dashboard shows a monthly spend bar (last 30d of runs).
MONTHLY_BUDGET_USD=
